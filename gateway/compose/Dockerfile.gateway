# Gateway service image: OpenLine authz service + mock API + OPA shim.
FROM python:3.12-slim

RUN pip install --no-cache-dir \
    grpcio==1.84.0 \
    protobuf==7.36.2 \
    cryptography==50.0.1

WORKDIR /app
# olp_gate (mandate evaluation) + gateway code
COPY olp_gate /app/olp_gate
COPY gateway /app/gateway

ENV PYTHONPATH=/app
EXPOSE 50051 50052 9000

# Default: run the OpenLine authorization service.
CMD ["python3", "/app/gateway/authz_server.py", "50051"]
